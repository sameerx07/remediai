/* ==========================================================================
   custom.css — Generated by docs-site-builder agent
   Design system: see DESIGN_SYSTEM.md in the agent folder.
   Theme: {{THEME_NAME}}
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Self-hosted fonts
   -------------------------------------------------------------------------- */

@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url('/fonts/InterVariable.woff2') format('woff2-variations'),
       url('/fonts/InterVariable.woff2') format('woff2');
}

@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-weight: 100 800;
  font-display: swap;
  src: url('/fonts/JetBrainsMonoVariable.woff2') format('woff2-variations'),
       url('/fonts/JetBrainsMonoVariable.woff2') format('woff2');
}

/* --------------------------------------------------------------------------
   2. Design tokens — light mode
   -------------------------------------------------------------------------- */

:root {
  /* Brand scale */
  --brand-50:  {{BRAND_50}};
  --brand-100: {{BRAND_100}};
  --brand-200: {{BRAND_200}};
  --brand-300: {{BRAND_300}};
  --brand-400: {{BRAND_400}};
  --brand-500: {{BRAND_500}};
  --brand-600: {{BRAND_600}};
  --brand-700: {{BRAND_700}};
  --brand-800: {{BRAND_800}};
  --brand-900: {{BRAND_900}};
  --brand-950: {{BRAND_950}};

  /* Accent scale */
  --accent-50:  {{ACCENT_50}};
  --accent-100: {{ACCENT_100}};
  --accent-200: {{ACCENT_200}};
  --accent-300: {{ACCENT_300}};
  --accent-400: {{ACCENT_400}};
  --accent-500: {{ACCENT_500}};
  --accent-600: {{ACCENT_600}};
  --accent-700: {{ACCENT_700}};
  --accent-800: {{ACCENT_800}};
  --accent-900: {{ACCENT_900}};
  --accent-950: {{ACCENT_950}};

  /* Semantic — light */
  --surface-0: {{L_SURFACE_0}};
  --surface-1: {{L_SURFACE_1}};
  --surface-2: {{L_SURFACE_2}};
  --surface-3: {{L_SURFACE_3}};
  --text-primary:   {{L_TEXT_PRIMARY}};
  --text-secondary: {{L_TEXT_SECONDARY}};
  --text-tertiary:  {{L_TEXT_TERTIARY}};
  --border-subtle: {{L_BORDER_SUBTLE}};
  --border-strong: {{L_BORDER_STRONG}};

  --brand-primary: var(--brand-500);
  --brand-accent:  var(--accent-500);
  --brand-gradient:      linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-accent) 100%);
  --brand-gradient-soft: linear-gradient(135deg, {{BRAND_500_RGB_15}} 0%, {{ACCENT_500_RGB_15}} 100%);
  --brand-gradient-mesh: conic-gradient(from 210deg at 50% 50%, var(--brand-primary) 0deg, var(--brand-accent) 120deg, var(--brand-600) 240deg, var(--brand-primary) 360deg);
  --brand-glow:          0 0 40px {{BRAND_500_RGB_30}};

  /* Docusaurus / Infima integration */
  --ifm-color-primary:         var(--brand-500);
  --ifm-color-primary-dark:    var(--brand-600);
  --ifm-color-primary-darker:  var(--brand-700);
  --ifm-color-primary-darkest: var(--brand-800);
  --ifm-color-primary-light:   var(--brand-400);
  --ifm-color-primary-lighter: var(--brand-300);
  --ifm-color-primary-lightest:var(--brand-200);

  --ifm-font-family-base: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --ifm-font-family-monospace: 'JetBrains Mono Variable', 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;

  --ifm-background-color: var(--surface-0);
  --ifm-background-surface-color: var(--surface-1);
  --ifm-font-color-base: var(--text-primary);
  --ifm-heading-color: var(--text-primary);
  --ifm-color-content-secondary: var(--text-secondary);

  --ifm-navbar-background-color: transparent;
  --ifm-navbar-height: 64px;
  --ifm-navbar-item-padding-vertical: 0.4rem;
  --ifm-navbar-item-padding-horizontal: 0.8rem;

  --ifm-code-font-size: 90%;
  --ifm-code-background: var(--surface-2);
  --ifm-code-padding-vertical: 0.15rem;
  --ifm-code-padding-horizontal: 0.35rem;
  --ifm-code-border-radius: 6px;

  --ifm-line-height-base: 1.7;
  --ifm-paragraph-margin-bottom: 1.1em;

  --ifm-link-color: var(--brand-600);
  --ifm-link-hover-color: var(--brand-700);
  --ifm-link-decoration: none;
  --ifm-link-hover-decoration: none;

  /* Motion */
  --ease-quick:  cubic-bezier(0.4, 0, 0.2, 1);
  --ease-smooth: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-slow:   cubic-bezier(0.22, 1, 0.36, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-quick:   150ms;
  --dur-smooth:  250ms;
  --dur-slow:    500ms;

  /* Spacing scale */
  --space-1: 2px;
  --space-2: 4px;
  --space-3: 8px;
  --space-4: 12px;
  --space-5: 16px;
  --space-6: 24px;
  --space-7: 32px;
  --space-8: 48px;
  --space-9: 64px;
  --space-10: 96px;
  --space-11: 128px;

  /* Radii */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --radius-full: 9999px;

  /* Shadows / glow */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 30px 60px rgba(0, 0, 0, 0.12);

  --scroll-progress: 0%;
}

/* --------------------------------------------------------------------------
   3. Dark mode overrides
   -------------------------------------------------------------------------- */

[data-theme='dark'] {
  --surface-0: {{D_SURFACE_0}};
  --surface-1: {{D_SURFACE_1}};
  --surface-2: {{D_SURFACE_2}};
  --surface-3: {{D_SURFACE_3}};
  --text-primary:   {{D_TEXT_PRIMARY}};
  --text-secondary: {{D_TEXT_SECONDARY}};
  --text-tertiary:  {{D_TEXT_TERTIARY}};
  --border-subtle: {{D_BORDER_SUBTLE}};
  --border-strong: {{D_BORDER_STRONG}};

  --brand-primary: var(--brand-400);
  --brand-accent:  var(--accent-400);
  --brand-gradient: linear-gradient(135deg, var(--brand-400) 0%, var(--accent-400) 100%);
  --brand-glow: 0 0 60px {{BRAND_400_RGB_25}};

  --ifm-color-primary:         var(--brand-400);
  --ifm-color-primary-dark:    var(--brand-500);
  --ifm-color-primary-darker:  var(--brand-600);
  --ifm-color-primary-darkest: var(--brand-700);
  --ifm-color-primary-light:   var(--brand-300);
  --ifm-color-primary-lighter: var(--brand-200);
  --ifm-color-primary-lightest:var(--brand-100);

  --ifm-link-color: var(--brand-300);
  --ifm-link-hover-color: var(--brand-200);

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.4);
  --shadow-xl: 0 30px 60px rgba(0, 0, 0, 0.5);
}

/* --------------------------------------------------------------------------
   4. Base — reset, body, links, scrollbar
   -------------------------------------------------------------------------- */

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--ifm-navbar-height) + 16px);
  transition: color var(--dur-smooth) var(--ease-quick),
              background-color var(--dur-smooth) var(--ease-quick);
}

body {
  font-feature-settings: 'ss01', 'ss02', 'cv11';
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  background: var(--surface-0);
  color: var(--text-primary);
}

::selection {
  background: {{BRAND_500_RGB_25}};
  color: var(--text-primary);
}

/* Custom scrollbar */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--border-strong) transparent;
}
*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
*::-webkit-scrollbar-track {
  background: transparent;
}
*::-webkit-scrollbar-thumb {
  background: var(--border-subtle);
  border-radius: 10px;
  border: 2px solid var(--surface-0);
}
*::-webkit-scrollbar-thumb:hover {
  background: var(--border-strong);
}

/* Focus ring */
:focus-visible {
  outline: 2px solid var(--brand-primary);
  outline-offset: 3px;
  border-radius: 4px;
}

.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* --------------------------------------------------------------------------
   5. Typography
   -------------------------------------------------------------------------- */

.markdown h1,
article h1,
h1.hero-headline {
  font-size: 2.75rem;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin: 0 0 1.5rem;
}

.markdown h2 {
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.02em;
  margin: 2.75rem 0 1rem;
  scroll-margin-top: 6rem;
}

.markdown h3 {
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.015em;
  margin: 2rem 0 0.75rem;
  color: var(--text-primary);
}

.markdown h4 {
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.01em;
  margin: 1.5rem 0 0.5rem;
  color: var(--text-primary);
}

.markdown p {
  color: var(--text-primary);
  line-height: 1.7;
  max-width: 68ch;
}

.markdown a {
  color: var(--brand-600);
  text-decoration: none;
  background: linear-gradient(currentColor, currentColor) bottom left / 0% 1px no-repeat;
  transition: background-size var(--dur-quick) var(--ease-quick), color var(--dur-quick);
}
.markdown a:hover {
  background-size: 100% 1px;
}

[data-theme='dark'] .markdown a { color: var(--brand-300); }

.markdown strong { color: var(--text-primary); font-weight: 600; }
.markdown em { color: var(--text-primary); }

/* Gradient text utility */
.gradient-text {
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-primary) 40%, var(--brand-primary) 70%, var(--brand-accent) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  background-size: 200% 200%;
  animation: shimmer 8s ease-in-out infinite;
}
@keyframes shimmer {
  0%, 100% { background-position: 0% 50%; }
  50%      { background-position: 100% 50%; }
}

/* --------------------------------------------------------------------------
   6. Navbar — glassmorphism
   -------------------------------------------------------------------------- */

.navbar {
  background: {{NAVBAR_BG_LIGHT}};
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid transparent;
  box-shadow: none;
  transition: border-color var(--dur-smooth), background var(--dur-smooth);
  z-index: 200;
}

[data-theme='dark'] .navbar {
  background: {{NAVBAR_BG_DARK}};
}

.navbar--fixed-top.navbar-sidebar--show ~ .main-wrapper .navbar,
html:not([data-scroll='top']) .navbar,
html[data-scroll='scrolled'] .navbar {
  border-bottom-color: var(--border-subtle);
}

.navbar__title {
  font-weight: 700;
  letter-spacing: -0.01em;
  font-size: 1rem;
  background: var(--brand-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.navbar__link {
  font-weight: 500;
  font-size: 0.9rem;
  color: var(--text-secondary);
  padding: 0.5rem 0.9rem;
  border-radius: var(--radius-md);
  transition: color var(--dur-quick), background var(--dur-quick);
}
.navbar__link:hover {
  color: var(--text-primary);
  background: var(--surface-2);
}
.navbar__link--active {
  color: var(--text-primary);
  background: var(--brand-gradient-soft);
  font-weight: 600;
}

.header-github-link:hover { opacity: 0.8; }
.header-github-link::before {
  content: '';
  width: 22px;
  height: 22px;
  display: flex;
  background: currentColor;
  mask: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5.99.1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3'/%3E%3C/svg%3E") no-repeat center / contain;
}

@media (max-width: 996px) {
  .navbar__title { font-size: 0.95rem; }
}

/* --------------------------------------------------------------------------
   7. Sidebar (left)
   -------------------------------------------------------------------------- */

.theme-doc-sidebar-container {
  border-right: 1px solid var(--border-subtle);
  background: transparent;
}

.menu {
  padding: 1.25rem 0.75rem;
  font-size: 0.875rem;
}

.menu__list-item-collapsible {
  border-radius: var(--radius-md);
  transition: background var(--dur-quick);
}
.menu__list-item-collapsible:hover {
  background: var(--surface-2);
}

.menu__link {
  color: var(--text-secondary);
  font-weight: 500;
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-md);
  line-height: 1.45;
  position: relative;
  transition: color var(--dur-quick), background var(--dur-quick);
}
.menu__link:hover {
  color: var(--text-primary);
  background: var(--surface-2);
}

.menu__link--active {
  color: var(--text-primary);
  font-weight: 600;
  background: var(--brand-gradient-soft);
}
.menu__link--active::before {
  content: '';
  position: absolute;
  left: -2px;
  top: 50%;
  width: 3px;
  height: 18px;
  border-radius: 4px;
  background: var(--brand-gradient);
  transform: translateY(-50%);
}

.menu__list .menu__list {
  padding-left: 0.75rem;
  margin-left: 0.25rem;
  border-left: 1px solid var(--border-subtle);
}

/* Category headers */
.theme-doc-sidebar-item-category > .menu__list-item-collapsible > .menu__link {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
  font-weight: 700;
}

/* --------------------------------------------------------------------------
   8. Right-side TOC — active indicator + progress
   -------------------------------------------------------------------------- */

.table-of-contents {
  font-size: 0.82rem;
  padding-left: 0.75rem;
  border-left: 1px solid var(--border-subtle);
  position: relative;
}

.table-of-contents::before {
  content: '';
  position: absolute;
  left: -1px;
  top: 0;
  width: 2px;
  height: var(--scroll-progress, 0%);
  background: var(--brand-gradient);
  transition: height var(--dur-quick) linear;
  border-radius: 2px;
}

.table-of-contents__link {
  color: var(--text-secondary);
  padding: 3px 0;
  display: block;
  transition: color var(--dur-quick);
}
.table-of-contents__link:hover { color: var(--text-primary); }
.table-of-contents__link--active {
  color: var(--brand-primary);
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   9. Doc page layout
   -------------------------------------------------------------------------- */

.main-wrapper { background: var(--surface-0); }

[class*='docPage'] { max-width: 100%; }
[class*='docItemContainer'] { padding: 2rem 0 4rem; }
article { max-width: 720px; margin: 0 auto; }

/* Pagination arrows at bottom of doc */
.pagination-nav {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-subtle);
}
.pagination-nav__link {
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 1rem 1.25rem;
  transition: border-color var(--dur-quick), transform var(--dur-quick);
}
.pagination-nav__link:hover {
  border-color: var(--brand-primary);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}
.pagination-nav__sublabel { color: var(--text-tertiary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
.pagination-nav__label { color: var(--text-primary); font-weight: 600; margin-top: 0.25rem; }

/* Breadcrumbs */
.theme-doc-breadcrumbs { margin-bottom: 1.5rem; }
.breadcrumbs__item { font-size: 0.8rem; }
.breadcrumbs__link {
  color: var(--text-tertiary);
  padding: 0.25rem 0.5rem;
  border-radius: var(--radius-sm);
}
.breadcrumbs__item--active .breadcrumbs__link {
  color: var(--text-primary);
  background: var(--surface-2);
}

/* --------------------------------------------------------------------------
   10. Code blocks
   -------------------------------------------------------------------------- */

.prism-code,
.theme-code-block {
  background: var(--surface-2) !important;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 0 !important;
  font-family: var(--ifm-font-family-monospace);
  font-size: 0.85rem;
  line-height: 1.65;
  position: relative;
  overflow: hidden;
}

.theme-code-block > pre {
  padding: 1.25rem 1.5rem !important;
  background: transparent !important;
}

/* Line highlighting via magicComments */
.code-line-highlight {
  background: {{BRAND_500_RGB_10}};
  display: block;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
  border-left: 2px solid var(--brand-primary);
}
.code-line-error {
  background: rgba(239, 68, 68, 0.12);
  display: block;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
  border-left: 2px solid #ef4444;
}
.code-line-success {
  background: rgba(16, 185, 129, 0.12);
  display: block;
  margin: 0 -1.5rem;
  padding: 0 1.5rem;
  border-left: 2px solid #10b981;
}

/* Copy button */
.clean-btn.theme-code-block__copy-button,
button.clean-btn[class*='copyButton'] {
  background: var(--surface-1) !important;
  border: 1px solid var(--border-subtle) !important;
  border-radius: var(--radius-md) !important;
  color: var(--text-secondary) !important;
  padding: 0.35rem 0.5rem !important;
  transition: all var(--dur-quick) var(--ease-quick);
}
.clean-btn.theme-code-block__copy-button:hover,
button.clean-btn[class*='copyButton']:hover {
  color: var(--brand-primary) !important;
  border-color: var(--brand-primary) !important;
  background: var(--surface-2) !important;
}

/* Inline code */
:not(pre) > code {
  background: {{BRAND_500_RGB_8}};
  color: var(--brand-700);
  border: 1px solid var(--border-subtle);
  padding: 0.15rem 0.4rem;
  border-radius: 6px;
  font-size: 0.85em;
  font-weight: 500;
}
[data-theme='dark'] :not(pre) > code {
  color: var(--brand-300);
  background: {{BRAND_500_RGB_15}};
}


/* --------------------------------------------------------------------------
   11. Admonitions (callouts) — 5 types
   -------------------------------------------------------------------------- */

.alert,
.theme-admonition,
.admonition {
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle);
  border-left-width: 4px;
  padding: 1rem 1.25rem;
  margin: 1.5rem 0;
  background: var(--surface-1);
  position: relative;
  overflow: hidden;
}

.alert::before,
.theme-admonition::before,
.admonition::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, currentColor 0%, transparent 20%);
  opacity: 0.06;
  pointer-events: none;
}

/* Info */
.alert--info,
.theme-admonition-info,
.admonition-info {
  color: #0ea5e9;
  border-left-color: #0ea5e9;
  background: linear-gradient(90deg, rgba(14, 165, 233, 0.08), var(--surface-1) 40%);
}

/* Tip */
.alert--success,
.theme-admonition-tip,
.admonition-tip,
.admonition-success {
  color: #10b981;
  border-left-color: #10b981;
  background: linear-gradient(90deg, rgba(16, 185, 129, 0.08), var(--surface-1) 40%);
}

/* Warning */
.alert--warning,
.theme-admonition-warning,
.admonition-warning,
.admonition-caution {
  color: #f59e0b;
  border-left-color: #f59e0b;
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.08), var(--surface-1) 40%);
}

/* Danger */
.alert--danger,
.theme-admonition-danger,
.admonition-danger {
  color: #ef4444;
  border-left-color: #ef4444;
  background: linear-gradient(90deg, rgba(239, 68, 68, 0.08), var(--surface-1) 40%);
}

/* Note (brand) */
.theme-admonition-note,
.admonition-note {
  color: var(--brand-primary);
  border-left-color: var(--brand-primary);
  background: linear-gradient(90deg, {{BRAND_500_RGB_10}}, var(--surface-1) 40%);
}

.admonitionHeading_,
.theme-admonition [class*='admonitionHeading'] {
  font-weight: 700;
  font-size: 0.875rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  color: currentColor;
}

.admonitionContent_,
.theme-admonition [class*='admonitionContent'] {
  color: var(--text-primary);
}
.admonitionContent_ p:last-child,
.theme-admonition [class*='admonitionContent'] p:last-child { margin-bottom: 0; }

/* --------------------------------------------------------------------------
   12. Tables
   -------------------------------------------------------------------------- */

.markdown table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 1.5rem 0;
  font-size: 0.9rem;
  display: table;
}

.markdown table thead {
  background: var(--surface-2);
}

.markdown table th {
  color: var(--text-tertiary);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.85rem 1rem;
  text-align: left;
  border: 0;
  border-bottom: 1px solid var(--border-subtle);
}

.markdown table td {
  padding: 0.85rem 1rem;
  border-top: 1px solid var(--border-subtle);
  color: var(--text-primary);
  vertical-align: top;
}

.markdown table tbody tr {
  transition: background var(--dur-quick);
}
.markdown table tbody tr:hover {
  background: var(--surface-2);
}
.markdown table tbody tr:nth-child(even) {
  background: {{BRAND_500_RGB_3}};
}

/* --------------------------------------------------------------------------
   13. Buttons
   -------------------------------------------------------------------------- */

.button {
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.7rem 1.4rem;
  border: 1px solid transparent;
  transition: transform var(--dur-quick) var(--ease-smooth),
              box-shadow var(--dur-quick) var(--ease-smooth),
              background var(--dur-quick),
              border-color var(--dur-quick);
  position: relative;
  overflow: hidden;
  letter-spacing: -0.01em;
}
.button:hover { text-decoration: none; }
.button.button--lg { padding: 0.9rem 1.75rem; font-size: 1rem; }

.button--primary {
  background: var(--brand-gradient);
  color: white;
  border: 0;
}
.button--primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.28) 50%, transparent 70%);
  transform: translateX(-100%);
  transition: transform 0.6s var(--ease-smooth);
}
.button--primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 30px {{BRAND_500_RGB_35}};
  color: white;
}
.button--primary:hover::before {
  transform: translateX(100%);
}

.button--outline {
  background: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border-strong);
}
.button--outline:hover {
  color: var(--brand-primary);
  border-color: var(--brand-primary);
  background: var(--surface-2);
}

.button--glass {
  background: rgba(255, 255, 255, 0.08);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: var(--text-primary);
}
[data-theme='dark'] .button--glass {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
}
.button--glass:hover {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.24);
}

/* --------------------------------------------------------------------------
   14. Section cards — reusable, cursor-tracked glow
   -------------------------------------------------------------------------- */

.section-card {
  position: relative;
  display: block;
  padding: 1.75rem;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  background: var(--surface-1);
  color: var(--text-primary);
  text-decoration: none;
  transition: transform var(--dur-slow) var(--ease-smooth),
              border-color var(--dur-smooth) var(--ease-quick);
  isolation: isolate;
  overflow: hidden;
}

.section-card::before {
  /* Radial glow that follows the cursor */
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: radial-gradient(
    600px circle at var(--mx, 50%) var(--my, 50%),
    {{BRAND_500_RGB_12}},
    transparent 40%
  );
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-smooth);
  pointer-events: none;
  z-index: -1;
}

.section-card::after {
  /* Gradient border on hover */
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: var(--brand-gradient);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: opacity var(--dur-smooth) var(--ease-smooth);
  pointer-events: none;
}

.section-card:hover {
  transform: translateY(-4px);
  color: var(--text-primary);
  text-decoration: none;
}
.section-card:hover::before,
.section-card:hover::after {
  opacity: 1;
}

.section-card__num {
  display: inline-block;
  font-family: var(--ifm-font-family-monospace);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--brand-primary);
  margin-bottom: 0.75rem;
  padding: 0.15rem 0.5rem;
  background: {{BRAND_500_RGB_10}};
  border-radius: 20px;
}

.section-card__title {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0 0 0.4rem;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  line-height: 1.35;
}

.section-card__desc {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.55;
  margin: 0;
}

.section-card__chevron {
  position: absolute;
  bottom: 1.75rem;
  right: 1.75rem;
  opacity: 0.4;
  transition: transform var(--dur-smooth) var(--ease-smooth), opacity var(--dur-smooth);
}
.section-card:hover .section-card__chevron {
  transform: translateX(4px);
  opacity: 1;
  color: var(--brand-primary);
}

/* --------------------------------------------------------------------------
   15. Aurora background — landing page hero
   -------------------------------------------------------------------------- */

.aurora {
  position: absolute;
  inset: 0;
  overflow: hidden;
  filter: blur(80px) saturate(140%);
  pointer-events: none;
  z-index: 0;
}

.aurora::before,
.aurora::after,
.aurora > span {
  content: '';
  position: absolute;
  width: 55vw;
  height: 55vw;
  border-radius: 50%;
  will-change: transform;
  animation: aurora-drift 22s ease-in-out infinite alternate;
}

.aurora::before {
  top: -20%; left: -10%;
  background: conic-gradient(from 90deg, var(--brand-500), var(--accent-500), var(--brand-500));
}

.aurora::after {
  bottom: -25%; right: -15%;
  background: conic-gradient(from 210deg, var(--accent-500), var(--brand-600), var(--accent-500));
  animation-delay: -8s;
}

.aurora > span {
  top: 30%; left: 40%;
  background: radial-gradient(circle, var(--accent-400) 0%, transparent 60%);
  animation-delay: -14s;
}

@keyframes aurora-drift {
  0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
  100% { transform: translate(6vw, -4vh) rotate(35deg) scale(1.15); }
}

/* Grid overlay used on hero */
.grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--border-subtle) 1px, transparent 1px),
    linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
  background-size: 40px 40px;
  mask-image: radial-gradient(ellipse 60% 60% at center, black 40%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 60% 60% at center, black 40%, transparent 100%);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
}

/* --------------------------------------------------------------------------
   16. Scroll progress bar
   -------------------------------------------------------------------------- */

.scroll-progress {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  width: var(--scroll-progress, 0%);
  background: var(--brand-gradient);
  box-shadow: 0 0 12px {{BRAND_500_RGB_60}};
  z-index: 1000;
  transition: width 0.05s linear;
  pointer-events: none;
}

/* --------------------------------------------------------------------------
   17. Command palette
   -------------------------------------------------------------------------- */

.cmdk-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 6, 17, 0.5);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  z-index: 2000;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 15vh;
  animation: cmdk-fade var(--dur-quick) var(--ease-quick);
}
@keyframes cmdk-fade { from { opacity: 0; } to { opacity: 1; } }

.cmdk-modal {
  width: 100%;
  max-width: 560px;
  background: var(--surface-1);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  box-shadow: 0 40px 80px rgba(0, 0, 0, 0.3), var(--brand-glow);
  overflow: hidden;
  animation: cmdk-slide var(--dur-smooth) var(--ease-smooth);
}
@keyframes cmdk-slide {
  from { opacity: 0; transform: translateY(-16px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.cmdk-input {
  width: 100%;
  padding: 1.25rem 1.5rem;
  font-size: 1.1rem;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text-primary);
  font-family: inherit;
  border-bottom: 1px solid var(--border-subtle);
}
.cmdk-input::placeholder { color: var(--text-tertiary); }

.cmdk-results {
  max-height: 60vh;
  overflow-y: auto;
  padding: 0.5rem;
}

.cmdk-result {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  cursor: pointer;
  transition: background var(--dur-quick);
}
.cmdk-result[aria-selected='true'],
.cmdk-result:hover {
  background: var(--brand-gradient-soft);
}
.cmdk-result__title { font-weight: 500; }
.cmdk-result__section { color: var(--text-tertiary); font-size: 0.8rem; margin-left: auto; }

.cmdk-footer {
  padding: 0.6rem 1rem;
  border-top: 1px solid var(--border-subtle);
  font-size: 0.75rem;
  color: var(--text-tertiary);
  display: flex;
  gap: 1.25rem;
  align-items: center;
}
.cmdk-kbd {
  display: inline-block;
  padding: 2px 6px;
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  background: var(--surface-2);
  font-family: var(--ifm-font-family-monospace);
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.cmdk-trigger {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  background: var(--surface-2);
  color: var(--text-tertiary);
  font-size: 0.85rem;
  cursor: pointer;
  transition: border-color var(--dur-quick), color var(--dur-quick);
}
.cmdk-trigger:hover {
  border-color: var(--brand-primary);
  color: var(--text-secondary);
}

/* --------------------------------------------------------------------------
   18. Blockquotes
   -------------------------------------------------------------------------- */

.markdown blockquote {
  border-left: 3px solid var(--brand-primary);
  background: var(--surface-2);
  color: var(--text-secondary);
  padding: 0.75rem 1.25rem;
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  margin: 1.5rem 0;
  font-style: italic;
}
.markdown blockquote p { margin: 0.5rem 0; }
.markdown blockquote p:first-child { margin-top: 0; }
.markdown blockquote p:last-child { margin-bottom: 0; }

/* --------------------------------------------------------------------------
   19. Hero section (landing page)
   -------------------------------------------------------------------------- */

.hero {
  position: relative;
  padding: 8rem 0 6rem;
  overflow: hidden;
  isolation: isolate;
}

.hero__inner {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--brand-primary);
  background: {{BRAND_500_RGB_10}};
  border: 1px solid {{BRAND_500_RGB_25}};
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-full);
  margin-bottom: 2rem;
}
.hero__eyebrow-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--brand-primary);
  box-shadow: 0 0 12px currentColor;
}

.hero__headline {
  font-size: clamp(2.5rem, 7vw, 5rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.04em;
  margin: 0 0 1.5rem;
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-primary) 30%, var(--brand-primary) 65%, var(--brand-accent) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  background-size: 200% 200%;
  animation: shimmer 10s ease-in-out infinite;
}

.hero__subheadline {
  font-size: clamp(1rem, 2vw, 1.25rem);
  line-height: 1.6;
  color: var(--text-secondary);
  max-width: 640px;
  margin: 0 auto 2.5rem;
  font-weight: 400;
}

.hero__cta-group {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

/* --------------------------------------------------------------------------
   20. Print styles
   -------------------------------------------------------------------------- */

@media print {
  .navbar,
  .theme-doc-sidebar-container,
  .theme-doc-toc-desktop,
  .pagination-nav,
  .footer,
  .scroll-progress,
  .aurora,
  .grid-overlay,
  .cmdk-trigger,
  .theme-doc-breadcrumbs {
    display: none !important;
  }
  html, body {
    background: white !important;
    color: black !important;
    font-size: 11pt !important;
  }
  article { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
  .markdown h1 { break-after: avoid; }
  .markdown h2, .markdown h3 { break-after: avoid-page; }
  .theme-code-block { break-inside: avoid; border: 1px solid #ccc !important; background: #f7f7f8 !important; }
  .markdown a[href]::after { content: ' (' attr(href) ')'; color: #666; font-size: 0.85em; word-break: break-all; }
  .markdown a[href^='#']::after { content: ''; }
}

/* --------------------------------------------------------------------------
   21. Reduced motion
   -------------------------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .aurora,
  .aurora::before,
  .aurora::after,
  .aurora > span,
  .hero__headline,
  .gradient-text {
    animation: none !important;
  }
}

/* --------------------------------------------------------------------------
   22. Mobile / responsive
   -------------------------------------------------------------------------- */

@media (max-width: 996px) {
  .navbar { padding: 0 0.75rem; }
  .navbar__title { max-width: 60vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hero { padding: 5rem 0 4rem; }
  .hero__headline { font-size: clamp(2rem, 8vw, 3rem); }
  .hero__cta-group .button { width: 100%; }
  article { padding: 0 1rem; }
  .markdown table { font-size: 0.85rem; display: block; overflow-x: auto; }
  .cmdk-modal { max-width: 92vw; }
  .cmdk-input { font-size: 1rem; padding: 1rem 1.25rem; }
}

/* --------------------------------------------------------------------------
   23. Utility classes
   -------------------------------------------------------------------------- */

.text-primary   { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary  { color: var(--text-tertiary); }
.text-gradient  { background: var(--brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }

.bg-surface-0 { background: var(--surface-0); }
.bg-surface-1 { background: var(--surface-1); }
.bg-surface-2 { background: var(--surface-2); }

.rounded-sm  { border-radius: var(--radius-sm); }
.rounded-md  { border-radius: var(--radius-md); }
.rounded-lg  { border-radius: var(--radius-lg); }
.rounded-xl  { border-radius: var(--radius-xl); }
.rounded-full{ border-radius: var(--radius-full); }

.glow { box-shadow: var(--brand-glow); }

.animate-in {
  animation: reveal-up var(--dur-slow) var(--ease-smooth) both;
}
@keyframes reveal-up {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
