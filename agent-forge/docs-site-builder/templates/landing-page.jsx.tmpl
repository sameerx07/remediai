import React, { useEffect, useRef } from 'react';
import Link from '@docusaurus/Link';
import Layout from '@theme/Layout';
import styles from './index.module.css';

const DOCS_ROOT = '/docs';

/**
 * SECTIONS is generated by the agent from the top-level folders in your
 * markdown source. Each entry becomes an animated section card.
 */
const SECTIONS = [
  {{SECTIONS_ARRAY}}
];

function SectionCard({ num, title, description, href, index }) {
  const ref = useRef(null);

  const onMouseMove = (e) => {
    if (!ref.current) return;
    const rect = ref.current.getBoundingClientRect();
    ref.current.style.setProperty('--mx', `${e.clientX - rect.left}px`);
    ref.current.style.setProperty('--my', `${e.clientY - rect.top}px`);
  };

  useEffect(() => {
    if (!ref.current) return;
    const el = ref.current;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            el.classList.add(styles.visible);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.12 }
    );
    io.observe(el);
    return () => io.disconnect();
  }, []);

  return (
    <Link
      to={href}
      className={`section-card ${styles.card}`}
      onMouseMove={onMouseMove}
      style={{ '--card-delay': `${index * 60}ms` }}
      ref={ref}
    >
      <span className="section-card__num">{num}</span>
      <h3 className="section-card__title">{title}</h3>
      <p className="section-card__desc">{description}</p>
      <svg
        className="section-card__chevron"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        strokeLinecap="round"
        strokeLinejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </Link>
  );
}

