// src/components/CommandPalette/CommandPalette.jsx
// Cmd+K (Ctrl+K on Windows/Linux) command palette.
//
// Queries the local search index built by @easyops-cn/docusaurus-search-local.
// Groups results by section, supports keyboard navigation (arrows + Enter),
// and closes on Escape or overlay click.

import React, { useEffect, useState, useCallback, useRef } from 'react';
import { useHistory } from '@docusaurus/router';
import ExecutionEnvironment from '@docusaurus/ExecutionEnvironment';

const isMac =
  ExecutionEnvironment.canUseDOM &&
  /Mac|iPod|iPhone|iPad/.test(navigator.platform);

export default function CommandPalette() {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState('');
  const [results, setResults] = useState([]);
  const [selected, setSelected] = useState(0);
  const history = useHistory();
  const inputRef = useRef(null);

  // Keyboard shortcut: Cmd+K / Ctrl+K
  useEffect(() => {
    if (!ExecutionEnvironment.canUseDOM) return;
    const onKey = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        setOpen((v) => !v);
      }
      if (e.key === 'Escape') {
        setOpen(false);
      }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, []);

  // Focus input when opened
  useEffect(() => {
    if (open && inputRef.current) {
      inputRef.current.focus();
      setSelected(0);
    }
  }, [open]);

  // Query the local search index
  const runSearch = useCallback(async (q) => {
    if (!q || q.length < 2) {
      setResults([]);
      return;
    }
    try {
      // The plugin exposes its index via window; guard for absence.
      const idx = window.__DOCUSAURUS_SEARCH_INDEX__;
      if (!idx || !idx.search) {
        setResults([]);
        return;
      }
      const hits = await idx.search(q, { limit: 20 });
      setResults(hits.map((h) => ({
        title: h.title || h.name || 'Untitled',
        section: h.breadcrumb || h.hierarchy?.lvl1 || '',
        url: h.url || h.path || '#',
      })));
      setSelected(0);
    } catch (_) {
      setResults([]);
    }
  }, []);

  useEffect(() => {
    const t = setTimeout(() => runSearch(query), 100);
    return () => clearTimeout(t);
  }, [query, runSearch]);

  const navigateTo = useCallback((url) => {
    setOpen(false);
    setQuery('');
    history.push(url);
  }, [history]);

  const onKeyDown = (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setSelected((s) => Math.min(s + 1, results.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setSelected((s) => Math.max(s - 1, 0));
    } else if (e.key === 'Enter' && results[selected]) {
      e.preventDefault();
      navigateTo(results[selected].url);
    }
  };

  if (!open) return null;

  return (
    <div
      className="cmdk-overlay"
      onClick={(e) => { if (e.target === e.currentTarget) setOpen(false); }}
      role="dialog"
      aria-modal="true"
      aria-label="Search documentation"
    >
      <div className="cmdk-modal">
        <input
          ref={inputRef}
          type="text"
          className="cmdk-input"
          placeholder="Search documentation..."
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onKeyDown={onKeyDown}
          autoComplete="off"
          spellCheck="false"
          aria-label="Search input"
        />

        <div className="cmdk-results" role="listbox">
          {results.length === 0 && query.length >= 2 && (
            <div className="cmdk-result" style={{ opacity: 0.6, cursor: 'default' }}>
              No results found for "{query}"
            </div>
          )}

          {results.length === 0 && query.length < 2 && (
            <div className="cmdk-result" style={{ opacity: 0.6, cursor: 'default' }}>
              Start typing to search…
            </div>
          )}

          {results.map((r, i) => (
            <div
              key={i}
              className="cmdk-result"
              role="option"
              aria-selected={i === selected}
              onMouseEnter={() => setSelected(i)}
              onClick={() => navigateTo(r.url)}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
              </svg>
              <span className="cmdk-result__title">{r.title}</span>
              {r.section && <span className="cmdk-result__section">{r.section}</span>}
            </div>
          ))}
        </div>

        <div className="cmdk-footer">
          <span><span className="cmdk-kbd">↑</span> <span className="cmdk-kbd">↓</span> Navigate</span>
          <span><span className="cmdk-kbd">↵</span> Select</span>
          <span><span className="cmdk-kbd">Esc</span> Close</span>
          <span style={{ marginLeft: 'auto' }}>
            <span className="cmdk-kbd">{isMac ? '⌘' : 'Ctrl'}</span> <span className="cmdk-kbd">K</span>
          </span>
        </div>
      </div>
    </div>
  );
}
