# ──────────────────────────────────────────────────────────────────────────────
# Deploy {{TITLE}} Docs → Azure Static Web Apps
#
# Generated by docs-site-builder agent.
#
# Triggers:
#   - Push to main affecting the docs site or source markdown
#   - Pull requests (preview environment per PR)
#   - Manual dispatch
#
# Required GitHub Secrets:
#   AZURE_STATIC_WEB_APPS_API_TOKEN
#     → Azure Portal › Static Web Apps › <your-swa› › Manage deployment token
#
# Optional:
#   ENTRA_TENANT_ID
#     → Required only if you enabled Azure AD auth. Value goes into
#       staticwebapp.config.json at build time.
# ──────────────────────────────────────────────────────────────────────────────

name: Deploy {{TITLE}} Docs

on:
  push:
    branches: [main]
    paths:
      - '{{DOCS_SITE_PATH}}/**'
      - '{{SOURCE_DOCS_PATH}}/**'
  pull_request:
    types: [opened, synchronize, reopened, closed]
    branches: [main]
    paths:
      - '{{DOCS_SITE_PATH}}/**'
      - '{{SOURCE_DOCS_PATH}}/**'
  workflow_dispatch:

jobs:
  build_and_deploy:
    name: Build and Deploy
    if: github.event_name != 'pull_request' || github.event.action != 'closed'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: {{DOCS_SITE_PATH}}/package-lock.json

      - name: Install dependencies
        working-directory: {{DOCS_SITE_PATH}}
        run: npm ci

      - name: Build documentation site
        working-directory: {{DOCS_SITE_PATH}}
        run: npm run build

      - name: Deploy to Azure Static Web Apps
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          repo_token: ${{ secrets.GITHUB_TOKEN }}
          action: upload
          app_location: {{DOCS_SITE_PATH}}/build
          output_location: ''
          skip_app_build: true

  close_pr_preview:
    name: Close PR Preview
    if: github.event_name == 'pull_request' && github.event.action == 'closed'
    runs-on: ubuntu-latest
    steps:
      - name: Close staging environment
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          action: close
          app_location: {{DOCS_SITE_PATH}}
