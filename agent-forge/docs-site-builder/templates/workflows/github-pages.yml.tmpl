# ──────────────────────────────────────────────────────────────────────────────
# Deploy {{TITLE}} Docs → GitHub Pages
#
# Generated by docs-site-builder agent.
#
# Before this workflow runs successfully:
#   1. Repo Settings → Pages → Source = "GitHub Actions"
#   2. Set the `url` and `baseUrl` in docusaurus.config.js to match your Pages URL
#      Example: url = 'https://<username>.github.io', baseUrl = '/<repo-name>/'
# ──────────────────────────────────────────────────────────────────────────────

name: Deploy {{TITLE}} Docs to GitHub Pages

on:
  push:
    branches: [main]
    paths:
      - '{{DOCS_SITE_PATH}}/**'
      - '{{SOURCE_DOCS_PATH}}/**'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: {{DOCS_SITE_PATH}}/package-lock.json

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Install dependencies
        working-directory: {{DOCS_SITE_PATH}}
        run: npm ci

      - name: Build
        working-directory: {{DOCS_SITE_PATH}}
        run: npm run build

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: {{DOCS_SITE_PATH}}/build

  deploy:
    name: Deploy
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
