// src/components/ScrollProgress/ScrollProgress.jsx
// Thin gradient progress bar at the top of the viewport that tracks
// how far the user has scrolled through the current page.
//
// The width is written to a CSS custom property `--scroll-progress` on the
// root element so both this bar AND the right-side TOC progress line
// (see .table-of-contents::before in custom.css) update from the same source.

import React, { useEffect } from 'react';
import ExecutionEnvironment from '@docusaurus/ExecutionEnvironment';

export default function ScrollProgress() {
  useEffect(() => {
    if (!ExecutionEnvironment.canUseDOM) return;

    let ticking = false;

    const update = () => {
      const doc = document.documentElement;
      const total = doc.scrollHeight - doc.clientHeight;
      const scrolled = total > 0 ? (window.scrollY / total) * 100 : 0;
      doc.style.setProperty('--scroll-progress', `${scrolled}%`);
      doc.dataset.scroll = window.scrollY > 4 ? 'scrolled' : 'top';
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    return () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', update);
    };
  }, []);

  return <div className="scroll-progress" aria-hidden="true" />;
}
