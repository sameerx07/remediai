// src/components/Callout/Callout.jsx
//
// Modern replacement for Docusaurus admonitions. Docusaurus's native
// `:::info` syntax also inherits our styles from custom.css, but this
// component lets you use inline JSX in your .mdx files with icons and
// full control.
//
// Usage inside .mdx:
//
//   import Callout from '@site/src/components/Callout/Callout';
//
//   <Callout type="info" title="Heads up">
//     Rendered content **with markdown** support.
//   </Callout>

import React from 'react';

const ICONS = {
  info: (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <circle cx="12" cy="12" r="10" />
      <path d="M12 8v4M12 16h.01" />
    </svg>
  ),
  tip: (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.5.4.8 1 .8 1.6V17h6.4v-.7c0-.6.3-1.2.8-1.6A7 7 0 0 0 12 2z" />
    </svg>
  ),
  warning: (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14a2 2 0 0 0 1.7 3h16a2 2 0 0 0 1.7-3zM12 9v4M12 17h.01" />
    </svg>
  ),
  danger: (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <circle cx="12" cy="12" r="10" />
      <path d="m4.9 4.9 14.2 14.2" />
    </svg>
  ),
  note: (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M14 3v4a1 1 0 0 0 1 1h4M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
    </svg>
  ),
};

const CLASS_BY_TYPE = {
  info: 'theme-admonition-info',
  tip: 'theme-admonition-tip',
  warning: 'theme-admonition-warning',
  danger: 'theme-admonition-danger',
  note: 'theme-admonition-note',
};

export default function Callout({ type = 'info', title, children }) {
  const cls = `theme-admonition ${CLASS_BY_TYPE[type] || CLASS_BY_TYPE.info}`;
  return (
    <div className={cls} role="note">
      <div style={{ display: 'flex', alignItems: 'center', gap: '0.6rem', marginBottom: '0.5rem' }}>
        <span
          style={{
            width: 24,
            height: 24,
            display: 'inline-flex',
            alignItems: 'center',
            justifyContent: 'center',
            color: 'inherit',
          }}
          aria-hidden="true"
        >
          {ICONS[type] || ICONS.info}
        </span>
        {title && (
          <span style={{ fontWeight: 700, textTransform: 'uppercase', fontSize: '0.8rem', letterSpacing: '0.04em' }}>
            {title}
          </span>
        )}
      </div>
      <div style={{ color: 'var(--text-primary)' }}>{children}</div>
    </div>
  );
}
