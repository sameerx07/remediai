/* Landing page — src/pages/index.module.css
 * Generated by docs-site-builder agent.
 * Works with global styles in src/css/custom.css (see .hero, .aurora,
 * .grid-overlay, .section-card in that file for the modern design system).
 */

.hero {
  composes: hero from global;
}

.heroInner {
  composes: hero__inner from global;
}

/* Card grid */
.cardGridSection {
  padding: 4rem 0 6rem;
  position: relative;
}

.cardGridInner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 clamp(1rem, 4vw, 3rem);
}

.cardGridEyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-tertiary);
  margin-bottom: 0.5rem;
  text-align: center;
}

.cardGridTitle {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  text-align: center;
  margin: 0 0 3rem;
  color: var(--text-primary);
}

.cardGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
}

.card {
  /* Composed on top of the global .section-card. Animation state below. */
  opacity: 0;
  transform: translateY(12px);
  transition:
    opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay, 0ms),
    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--card-delay, 0ms),
    border-color 0.25s ease;
}

.card.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .card {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
