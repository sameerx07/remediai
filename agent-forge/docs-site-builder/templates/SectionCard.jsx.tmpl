// src/components/SectionCard/SectionCard.jsx
//
// Reusable card component. Import from any .mdx file to build custom
// grids inside your docs:
//
//   import SectionCard from '@site/src/components/SectionCard/SectionCard';
//
//   <div style={{display:'grid', gridTemplateColumns:'repeat(auto-fill, minmax(280px, 1fr))', gap:'1.25rem'}}>
//     <SectionCard num="01" title="Getting Started" description="..." href="/docs/getting-started" />
//     <SectionCard num="02" title="Architecture" description="..." href="/docs/architecture" />
//   </div>

import React, { useRef } from 'react';
import Link from '@docusaurus/Link';

export default function SectionCard({ num, title, description, href }) {
  const ref = useRef(null);

  const onMouseMove = (e) => {
    if (!ref.current) return;
    const rect = ref.current.getBoundingClientRect();
    ref.current.style.setProperty('--mx', `${e.clientX - rect.left}px`);
    ref.current.style.setProperty('--my', `${e.clientY - rect.top}px`);
  };

  return (
    <Link
      to={href}
      className="section-card"
      onMouseMove={onMouseMove}
      ref={ref}
    >
      {num && <span className="section-card__num">{num}</span>}
      <h3 className="section-card__title">{title}</h3>
      <p className="section-card__desc">{description}</p>
      <svg
        className="section-card__chevron"
        width="18" height="18"
        viewBox="0 0 24 24"
        fill="none" stroke="currentColor"
        strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </Link>
  );
}
